# Storage Architecture (Single-Drive Mount)
DRIVE_ROOT=/mnt/media
DATA_BASE=${DRIVE_ROOT}/data
MONITOR_BASE=${DRIVE_ROOT}/monitoring
REG_BASE=${HOME}/.config/containers/storage

# Docker socket path (/run/docker.sock for rootful, /run/user/1000/docker.sock for rootless)
DOCKER_SOCK=/run/docker.sock

# Identity & Security
PUID=1000
PGID=1000
TZ=America/New_York
DOMAIN=smigula.io
REG_DOMAIN=registry.smigula.io

# App Ports
RADARR_PORT=7878
SONARR_PORT=8989
QBIT_PORT=10080
MINIO_PORT=9000

# Dozze variables
DOZZLE_NO_ANALYTICS=true
DOZZLE_ADDR=:9080
DOZZLE_HOSTNAME=dozzle.smigula.io
DOZZLE_LEVEL=debug
DOZZLE_AUTH_PROVIDER=forward-proxy

# MinIO Config (Sensitive values in all.env.dec)
MINIO_ENDPOINT=http://minio:9000